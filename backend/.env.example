# SQLite (local) — for Postgres use: postgresql://user:pass@localhost:5432/kayan
DATABASE_URL="file:./dev.db"

PORT=3000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP: dev | unifonic | twilio
OTP_PROVIDER=dev
# In dev mode any 6-digit code works unless OTP_STRICT=true
# Production providers default to strict verification.
OTP_STRICT=false
OTP_TTL_MINUTES=10
OTP_MAX_PER_HOUR=5
OTP_COOLDOWN_SECONDS=30
# OTP_MESSAGE_TEMPLATE=رمز كيان: {code}

# Unifonic (Phase 3 — recommended for GCC)
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=KAYAN
# UNIFONIC_BASE_URL=https://el.cloud.unifonic.com

# Twilio (Phase 3 alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase Admin (FCM push) — path to service account JSON, or inline JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS — comma-separated origins (empty = allow all in development)
CORS_ORIGINS=

# Payments (Phase 2): mock | tap | hyperpay | paymob
PAYMENT_PROVIDER=mock
PAYMENT_REDIRECT_BASE=https://pay.example.com/checkout
# TAP_SECRET_KEY=
# HYPERPAY_ENTITY_ID=
# PAYMOB_API_KEY=
