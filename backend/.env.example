# ── Database (PostgreSQL required) ──────────────────────────
DATABASE_URL="postgresql://kayan:kayan@127.0.0.1:5432/kayan"

PORT=3000
NODE_ENV=development

# JWT (Required / Secret) — use ≥32 random chars in production
JWT_ACCESS_SECRET=dev-only-access-secret-min-32-chars!!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP: dev | unifonic | twilio
# Production: OTP_PROVIDER must NOT be dev; OTP_STRICT must be true
OTP_PROVIDER=dev
OTP_STRICT=false
OTP_TTL_MINUTES=10
OTP_MAX_PER_HOUR=5
OTP_COOLDOWN_SECONDS=30
# OTP_MESSAGE_TEMPLATE=رمز كيان: {code}

# Unifonic (recommended for GCC) — Secret: UNIFONIC_APP_SID
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=KAYAN
# UNIFONIC_BASE_URL=https://el.cloud.unifonic.com

# Twilio alternative
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase Admin (FCM) — optional; without → log mode
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS — Required in production (comma-separated). Empty only allowed in development.
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# Payments: mock | tap | hyperpay | paymob
# hyperpay/paymob createIntent is rejected until fully implemented.
PAYMENT_PROVIDER=mock
PAYMENT_REDIRECT_BASE=https://pay.example.com/checkout
# Webhook HMAC secret (Required for non-mock). Header: x-kayan-signature
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Dev-only: allow POST /payments/confirm for mock. Forbidden in production.
PAYMENT_ALLOW_CLIENT_CONFIRM=true
# TAP_SECRET_KEY=
# HYPERPAY_ENTITY_ID=   # not production-wired yet
# PAYMOB_API_KEY=       # not production-wired yet

# Docker Compose helpers (optional; used by docker-compose.yml)
# POSTGRES_USER=kayan
# POSTGRES_PASSWORD=
# POSTGRES_DB=kayan
