# SQLite (local) — for Postgres use: postgresql://user:pass@localhost:5432/kayan
DATABASE_URL="file:./dev.db"

PORT=3000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP: dev | unifonic | twilio
OTP_PROVIDER=dev
# In dev mode any 6-digit code works unless OTP_STRICT=true
OTP_STRICT=false
OTP_TTL_MINUTES=10

# Unifonic (Phase 3)
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=

# Twilio (Phase 3)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# CORS — comma-separated origins (empty = allow all in development)
CORS_ORIGINS=
