generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(cuid())
  phone              String?        @unique
  email              String?        @unique
  passwordHash       String?
  name               String?
  isProfileComplete  Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  refreshTokens      RefreshToken[]
  otpCodes           OtpCode[]
  addresses          Address[]
  cart               Cart?
  orders             Order[]
  payments           Payment[]
  deviceTokens       DeviceToken[]
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  String   @default("android") // android | ios | web
  locale    String?  // ar | en
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([token])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  nameAr      String
  nameEn      String
  iconUrl     String?
  color       String?
  sortOrder   Int       @default(0)
  isEmergency Boolean   @default(false)
  kind        String    // ecommerce | service
  products    Product[]
}

model Banner {
  id          String  @id @default(cuid())
  imageUrl    String
  titleAr     String?
  titleEn     String?
  subtitleAr  String?
  subtitleEn  String?
  actionRoute String?
  actionParam String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

model Vendor {
  id           String    @id @default(cuid())
  businessName String
  slug         String    @unique
  products     Product[]
}

model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  nameAr         String
  nameEn         String
  descriptionAr  String?
  descriptionEn  String?
  price          Float
  compareAtPrice Float?
  currency       String         @default("SAR")
  status         String         @default("ACTIVE")
  stock          Int            @default(0)
  rating         Float          @default(0)
  totalRatings   Int            @default(0)
  isFeatured     Boolean        @default(false)
  freeShipping   Boolean        @default(false)
  deliveryDays   Int?
  tagsJson       String         @default("[]")
  flashDealEndsAt DateTime?
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id])
  vendorId       String?
  vendor         Vendor?        @relation(fields: [vendorId], references: [id])
  images         ProductImage[]
  cartItems      CartItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
  @@index([isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  isMain    Boolean @default(false)
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ServiceCard {
  id             String  @id @default(cuid())
  slug           String  @unique
  nameAr         String
  nameEn         String
  basePrice      Float
  imageUrl       String?
  rating         Float   @default(0)
  totalBookings  Int     @default(0)
  categoryNameAr String?
  isEmergency    Boolean @default(false)
  pricingType    String  @default("FIXED")
  isFeatured     Boolean @default(true)
}

model AdCard {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  price       Float?
  thumbnailUrl String?
  city        String
  isBoosted   Boolean  @default(false)
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Address {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  recipientName String
  phone         String
  country       String  @default("SA")
  city          String
  district      String
  streetLine1   String
  streetLine2   String?
  isDefault     Boolean @default(false)
  orders        Order[]

  @@index([userId])
}

model Cart {
  id             String     @id @default(cuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponCode     String?
  couponDiscount Float      @default(0)
  items          CartItem[]
  updatedAt      DateTime   @updatedAt
  createdAt      DateTime   @default(now())
}

model CartItem {
  id            String  @id @default(cuid())
  cartId        String
  cart          Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int     @default(1)
  selectedColor String?
  selectedSize  String?

  @@index([cartId])
  @@index([cartId, productId])
}

model Order {
  id             String      @id // KYN-...
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  addressId      String?
  address        Address?    @relation(fields: [addressId], references: [id])
  status         String      @default("pending") // pending|paid|shipping|delivered|cancelled
  paymentMethod  String
  couponCode     String?
  subtotal       Float
  discount       Float       @default(0)
  shipping       Float       @default(0)
  vat            Float       @default(0)
  total          Float
  currency       String      @default("SAR")
  titleAr        String?
  titleEn        String?
  items          OrderItem[]
  payments       Payment[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  slug          String
  nameAr        String
  nameEn        String
  imageUrl      String?
  unitPrice     Float
  quantity      Int
  selectedColor String?
  selectedSize  String?
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String   // cod|tap|hyperpay|mock_card|wallet|tabby|tamara|applepay
  method      String
  status      String   @default("pending") // pending|authorized|paid|failed|refunded
  amount      Float
  currency    String   @default("SAR")
  providerRef String?
  redirectUrl String?
  rawJson     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
}
